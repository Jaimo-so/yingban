# Server
YINGBAN_HOST=127.0.0.1
# Railway and similar managed platforms inject PORT automatically. When PORT is
# present it takes precedence; YINGBAN_PORT remains the local fallback.
YINGBAN_PORT=8765
YINGBAN_COOKIE_SECURE=false
YINGBAN_SESSION_DAYS=30

# Production only: mount a persistent volume at /data before using this path.
# YINGBAN_DATABASE=/data/yingban.db
# Keep WAL for local/block storage. SQLite WAL is unsupported on NAS/NFS;
# set DELETE for a network-mounted database.
YINGBAN_SQLITE_JOURNAL_MODE=WAL
# For veFaaS NAS (nolock): DELETE + unix-dotfile must be used by every reader,
# writer, and backup command. An orphan .lock directory requires stopped-writer recovery.
# YINGBAN_SQLITE_VFS=unix-dotfile
# Require a real mount and an already migrated database; fail instead of creating an empty DB.
# YINGBAN_DATABASE_MOUNT=/mnt/yingban

# Replace all three before any public deployment.
YINGBAN_INVITE_PEPPER=replace-with-a-long-random-secret
YINGBAN_SESSION_SECRET=replace-with-another-long-random-secret
YINGBAN_ADMIN_TOKEN=replace-with-a-private-admin-token

# Optional startup defaults. The admin page can save model settings at runtime.
# Without a key, the complete product flow runs with the built-in demo Agent.
MODEL_PROVIDER=anthropic
MODEL_API_KEY=
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-4-6
MODEL_BASE_URL=https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_TIMEOUT_SECONDS=60

# StepFun Step Plan example. STEPFUN_API_KEY is also the fallback for text,
# voice and image settings when their dedicated API key is empty.
# MODEL_PROVIDER=stepfun
# STEPFUN_API_KEY=
# MODEL_ID=step-3.5-flash-2603
# MODEL_BASE_URL=https://api.stepfun.com/step_plan/v1

# Optional startup defaults for live movie discovery and real poster images.
# The admin page can save these at runtime; TMDB accepts either a v3 API key
# or an API Read Access Token.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Optional Web Search for general, Douban and Zhihu site-scoped search.
# Bocha is the default recommendation. Tavily and Brave remain compatible.
# Pricing and quota depend on the selected provider account.
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.bochaai.com/v1
WEB_READER_ENABLED=true
WEB_READER_BASE_URL=https://r.jina.ai

# Optional Doubao speech-to-text and text-to-speech service. The new console
# uses VOICE_API_KEY only. Legacy console credentials use APP_ID + ACCESS_TOKEN.
VOICE_PROVIDER=doubao
VOICE_API_KEY=
VOICE_APP_ID=
VOICE_ACCESS_TOKEN=
VOICE_BASE_URL=https://openspeech.bytedance.com
VOICE_STT_MODEL=volc.bigasr.auc_turbo
VOICE_TTS_MODEL=seed-tts-2.0
VOICE_CHAT_MODEL=stepaudio-2.5-chat
VOICE_REALTIME_MODEL=stepaudio-2.5-realtime
VOICE_NAME=zh_female_xiaohe_uranus_bigtts
VOICE_AUDIO_FORMAT=mp3
VOICE_TIMEOUT_SECONDS=60

# Optional StepFun image generation/editing startup defaults.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.stepfun.com/step_plan/v1
IMAGE_MODEL=step-image-edit-2
IMAGE_TIMEOUT_SECONDS=60
